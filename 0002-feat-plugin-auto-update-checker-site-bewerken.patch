+              setError(result.error)
+              setLoading(false)
+            }
+          }}
+          disabled={loading}
+          className="btn btn-sm bg-danger text-white hover:bg-danger/90 transition-colors"
+        >
+          {loading ? 'Verwijderen…' : 'Ja, verwijder'}
+        </button>
