+import { NextResponse } from 'next/server'
+
+// Bump this version number each time a new plugin ZIP is released.
+// The ZIP URL below must point to the matching build.
+const PLUGIN_VERSION = '1.2.0'
+const PLUGIN_DOWNLOAD_URL = `https://app.verploy.com/downloads/verploy-connector-${PLUGIN_VERSION}.zip`
+const PLUGIN_DETAILS_URL  = 'https://verploy.com/docs/connector'
+
+export const revalidate = 3600 // cache 1 uur
+
+export async function GET() {
+  return NextResponse.json({
+    version:      PLUGIN_VERSION,
+    download_url: PLUGIN_DOWNLOAD_URL,
+    details_url:  PLUGIN_DETAILS_URL,
+    tested_up_to: '6.7',
+    requires:     '5.8',
+    requires_php: '7.4',
+    slug:         'verploy-connector',
+    name:         'Verploy Connector',
+    author:       'Verploy',
+  })
+}
