+
+import { useState } from 'react'
+import { Trash2 } from 'lucide-react'
+
+interface Props {
+  siteId: string
+  siteName: string
+  onDelete: (siteId: string) => Promise<{ error?: string } | void>
+}
+
+export default function DeleteSiteButton({ siteId, siteName, onDelete }: Props) {
+  const [confirming, setConfirming] = useState(false)
+  const [loading, setLoading] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+
+  if (!confirming) {
+    return (
+      <button
+        onClick={() => setConfirming(true)}
+        className="btn btn-sm text-danger border border-danger/40 hover:bg-danger/10 transition-colors flex items-center gap-1.5"
+      >
+        <Trash2 size={13} /> Site verwijderen
+      </button>
+    )
+  }
+
+  return (
+    <div className="space-y-3">
+      {error && (
+        <p className="text-danger text-xs bg-danger/10 px-3 py-2 rounded-lg">{error}</p>
