# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://app.verploy.com

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Create these in Stripe Dashboard → Products:
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_AGENCY_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# ── Resend (email) ────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@verploy.com
# Get API key at: https://resend.com

# ── Railway worker ────────────────────────────────────────
WORKER_URL=https://verploy-worker-production.up.railway.app
# Generate with: openssl rand -hex 32
WORKER_SECRET=your_random_secret_here

# ── OpenAI (used by worker for AI diagnosis) ──────────────
# Add this to Railway env vars, not here
# OPENAI_API_KEY=sk-...
