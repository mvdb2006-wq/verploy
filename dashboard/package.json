{
  "name": "verploy-dashboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:types": "node scripts/gen-db-types.mjs",
    "worker:build": "vite build --config worker/vite.config.ts",
    "worker": "node --enable-source-maps worker/dist/main.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "pixelmatch": "^7.2.0",
    "playwright-core": "1.63.0",
    "pngjs": "^7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22",
    "@types/pg": "8",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "pg": "8.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
