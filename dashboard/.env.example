# ── Verploy dashboard — omgevingsvariabelen ─────────────────────────────────
# Kopieer naar .env.local voor lokaal gebruik. Zet dezelfde namen in Vercel
# (Project → Settings → Environment Variables). Nooit echte waarden committen.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Publieke URL van de app (links in e-mails, koppel-redirects)
NEXT_PUBLIC_APP_URL=https://app.verploy.com

# Optioneel maar aanbevolen: eigen sleutel voor site-secrets (32 bytes, base64).
# Genereren: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Zonder deze variabele wordt een sleutel afgeleid van SUPABASE_SERVICE_ROLE_KEY.
VERPLOY_ENCRYPTION_KEY=

# E-mail via Resend (zonder sleutel: uitnodigingslinks worden in de UI getoond)
RESEND_API_KEY=
RESEND_FROM=Verploy <noreply@verploy.com>

# Beveiligt /api/cron/* (Vercel Cron stuurt dit mee als Bearer-token)
CRON_SECRET=
