# ── Verploy dashboard — omgevingsvariabelen ─────────────────────────────────
# Kopieer naar .env.local voor lokaal gebruik. Zet dezelfde namen in Vercel
# (Project → Settings → Environment Variables). Nooit echte waarden committen.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Publieke URL van de app (links in e-mails, koppel-redirects)
NEXT_PUBLIC_APP_URL=https://app.verploy.com

# Optioneel maar aanbevolen: eigen sleutel voor site-secrets (32 bytes, base64).
# Genereren: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Zonder deze variabele wordt een sleutel afgeleid van SUPABASE_SERVICE_ROLE_KEY.
VERPLOY_ENCRYPTION_KEY=

# E-mail via Resend (zonder sleutel: uitnodigingslinks worden in de UI getoond)
RESEND_API_KEY=
RESEND_FROM=Verploy <noreply@verploy.com>

# Beveiligt /api/cron/maintenance (Vercel Cron en de worker sturen dit mee als Bearer-token).
# Zonder waarde is de route uitgeschakeld. Genereren: openssl rand -hex 32
CRON_SECRET=

# Alleen voor lokale tests: stuur Resend-verkeer naar een mock (zie e2e/support/mock-resend.mjs)
# RESEND_BASE_URL=http://127.0.0.1:4010

# ── Worker (Railway) ─────────────────────────────────────────────────────────
# De worker gebruikt dezelfde variabelen als hierboven (Supabase-URL + keys, VERPLOY_ENCRYPTION_KEY,
# RESEND_*, NEXT_PUBLIC_APP_URL) plus deze, allemaal optioneel:
# WORKER_ID=railway-1                 # naam in logs en in update_runs.worker_id (standaard hostnaam-pid)
# WORKER_POLL_MS=5000                 # hoe vaak de wachtrij wordt bekeken
# WORKER_MAINTENANCE_MS=300000        # monitoringonderhoud (SSL/domein/drempels/e-mail) elke 5 min
# WORKER_HEALTH_PORT=8080             # healthcheck; Railway zet PORT, die wordt ook gebruikt
# PLAYWRIGHT_CHROMIUM_PATH=           # alleen nodig buiten het Playwright-image
