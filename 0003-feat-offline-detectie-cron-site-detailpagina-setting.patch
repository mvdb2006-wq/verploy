+        <div className="grid grid-cols-2 gap-4 text-sm">
+          <div>
+            <p className="label">URL</p>
+            <a href={site.url} target="_blank" rel="noopener" className="text-accent hover:underline font-mono text-xs break-all">
+              {site.url}
+            </a>
+          </div>
