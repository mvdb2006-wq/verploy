+          <p className="section-label mb-0.5">Instellingen → Sites</p>
+          <h1 className="text-2xl font-extrabold text-text tracking-tight truncate">{site.name}</h1>
+        </div>
+        <StatusBadge status={site.status} />
+      </div>
+
+      {/* Algemeen */}
