+}
+
+export default function EditSiteForm({
+  siteId, initialName, initialUrl, initialClientName, updateAction
+}: Props) {
+  const router = useRouter()
+  const [editing, setEditing] = useState(false)
+  const [loading, setLoading] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+
+  if (!editing) {
+    return (
+      <button
+        onClick={() => setEditing(true)}
+        className="btn btn-ghost btn-sm text-xs mb-4"
+      >
+        Sitegegevens bewerken
+      </button>
+    )
+  }
+
+  async function handleSubmit(e: React.FormEvent<HTMLFormElement>) {
+    e.preventDefault()
+    setLoading(true)
+    setError(null)
+    const fd = new FormData(e.currentTarget)
+    fd.append('siteId', siteId)
+    const result = await updateAction(fd)
+    if (result?.error) {
+      setError(result.error)
+      setLoading(false)
+    } else {
+      setEditing(false)
+      setLoading(false)
+      router.refresh()
+    }
+  }
+
+  return (
+    <form onSubmit={handleSubmit} className="card mb-4">
+      <h2 className="font-bold text-text mb-4 text-sm">Site bewerken</h2>
+      {error && (
+        <p className="text-danger text-xs mb-3 bg-danger/10 px-3 py-2 rounded-lg">{error}</p>
+      )}
+      <div className="space-y-3">
+        <div>
+          <label className="label block mb-1" htmlFor="edit-name">Naam</label>
+          <input id="edit-name" name="name" type="text" defaultValue={initialName}
+            required className="input w-full text-sm" placeholder="Mijn WordPress site" />
+        </div>
+        <div>
+          <label className="label block mb-1" htmlFor="edit-url">URL</label>
+          <input id="edit-url" name="url" type="url" defaultValue={initialUrl}
+            required className="input w-full text-sm font-mono" placeholder="https://jouwsite.nl" />
+        </div>
+        <div>
+          <label className="label block mb-1" htmlFor="edit-client">Klantnaam (optioneel)</label>
+          <input id="edit-client" name="client_name" type="text" defaultValue={initialClientName}
+            className="input w-full text-sm" placeholder="Naam van de klant" />
+        </div>
+      </div>
+      <div className="flex gap-2 mt-4">
+        <button type="submit" disabled={loading} className="btn btn-primary btn-sm">
+          {loading ? 'Opslaan…' : 'Opslaan'}
+        </button>
+        <button type="button" onClick={() => { setEditing(false); setError(null) }}
+          className="btn btn-ghost btn-sm">
+          Annuleren
+        </button>
+      </div>
+    </form>
+  )
+}
